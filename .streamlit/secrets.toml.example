# Copy to .streamlit/secrets.toml (never commit the real file) and fill in your Kite Connect app keys.
# On Streamlit Community Cloud, paste these lines into App settings -> Secrets instead.
KITE_API_KEY = "your_api_key"
KITE_API_SECRET = "your_api_secret"
# Optional: a token you generated yourself today. Usually leave empty and use "Log in with Zerodha".
# KITE_ACCESS_TOKEN = ""

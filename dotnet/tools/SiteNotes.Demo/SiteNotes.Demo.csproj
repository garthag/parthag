<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Heavy end-to-end demo and self-check: builds several realistic projects with months of daily reports,
    edits/deletes, syncs three devices through the real server, recalculates everything independently,
    generates every report and writes a verification log + PDF.
    Run:  dotnet run -c Release (project dotnet/tools/SiteNotes.Demo), arguments: output-folder [days]
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SiteNotes.Core\SiteNotes.Core.csproj" />
    <ProjectReference Include="..\..\src\SiteNotes.Server\SiteNotes.Server.csproj" />
  </ItemGroup>
</Project>

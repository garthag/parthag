# Secrets for the `drive` edge function. Set them with:
#   supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)

# Option A — document-controller Google account (works with free Gmail):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option B — service account + Shared Drive (Google Workspace):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SHARED_DRIVE_ID=

# Optional: put everything under this folder instead of My Drive root.
DRIVE_ROOT_FOLDER_ID=
# Comma-separated origins allowed to call the function (recommended). Include the
# Android app (https://localhost) and the Windows app (app://dpr) if you use them.
ALLOWED_ORIGINS=https://dpr.example.com,https://localhost,app://dpr

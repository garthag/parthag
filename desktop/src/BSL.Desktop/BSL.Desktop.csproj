<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BSLProjectControl</AssemblyName>
    <RootNamespace>BSL.Desktop</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <Version>1.1.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Company>BSL BF#3 Revamp</Company>
    <Description>BSL Project Control – drawings, BOM, contractors, work orders, BOQ and RA bills</Description>
    <Product>BSL Project Control</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BSL.Core\BSL.Core.csproj" />
  </ItemGroup>
</Project>

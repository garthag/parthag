<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Android app: native .NET MAUI, every screen written in C# (no web pages, no XAML). Installs directly from an .apk. -->
  <PropertyGroup>
    <!-- net10.0 only compiles the C# for checks and tests on any PC; the app itself is net10.0-android. -->
    <TargetFrameworks>net10.0-android;net10.0</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
    <RootNamespace>ConstructDpr.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>CONSTRUCT DPR</ApplicationTitle>
    <ApplicationId>org.constructdpr.dpr</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">24.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- -p:CdprScreenshots=true builds the test-only screenshot mode (never used for the released .apk). -->
    <DefineConstants Condition="'$(CdprScreenshots)' == 'true'">$(DefineConstants);SCREENSHOTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F3D5E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B2236" BaseSize="160,160" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConstructDpr.Client\ConstructDpr.Client.csproj" />
  </ItemGroup>
</Project>

@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject Notifier Notes
@inject NavigationManager Nav

@if (!_ready)
{
    <div class="loading"><span class="spinner"></span> Loading…</div>
}
else
{
    <div class="shell">
        <aside class="side">
            <div class="logo"><b>CONSTRUCT</b><span>DPR</span></div>
            <nav>
                <NavLink href="" Match="NavLinkMatch.All">▦ Dashboard</NavLink>
                <NavLink href="dprs">✎ Daily reports</NavLink>
                <NavLink href="approvals">✔ Approvals</NavLink>
                <NavLink href="activities">☰ Activities &amp; BOQ</NavLink>
                <NavLink href="schedule">▤ Schedule (Gantt)</NavLink>
                <NavLink href="reports">⎙ Reports &amp; Excel</NavLink>
                <NavLink href="projects">◫ Projects</NavLink>
                <NavLink href="settings">⚙ Settings</NavLink>
            </nav>
            <div class="me">Signed in as<b>@State.Me?.DisplayName</b>@State.Me?.Email</div>
        </aside>
        <div class="main">
            <header class="top">
                <div class="proj">
                    @if (State.Projects.Count > 0)
                    {
                        <select value="@State.ProjectId" @onchange="OnProject" aria-label="Project">
                            @foreach (var p in State.Projects)
                            {
                                <option value="@p.Id">@p.Code — @p.Name</option>
                            }
                        </select>
                        <div class="who">@(State.Project is null ? "" : Permissions.Label(State.Role)) · @State.Me?.DisplayName</div>
                    }
                    else
                    {
                        <b>CONSTRUCT DPR</b>
                    }
                </div>
                <span class="small muted nowrap" title="Live updates from the server"><span class="dot @State.LiveStatus"></span> @LiveText</span>
            </header>
            <main class="content">
                @if (State.Project is null && !IsFreePage)
                {
                    <NoProject />
                }
                else
                {
                    @Body
                }
            </main>
            <nav class="bottom">
                <NavLink href="" Match="NavLinkMatch.All"><span class="ic">▦</span>Home</NavLink>
                <NavLink href="dprs"><span class="ic">✎</span>Reports</NavLink>
                <NavLink href="approvals"><span class="ic">✔</span>Approve</NavLink>
                <NavLink href="schedule"><span class="ic">▤</span>Schedule</NavLink>
                <NavLink href="more"><span class="ic">☰</span>More</NavLink>
            </nav>
        </div>
    </div>
}
<Toasts />

@code {
    private bool _ready;
    private string LiveText => State.LiveStatus switch { "live" => "Live", "reconnecting" => "Reconnecting", "connecting" => "Connecting", _ => "Offline" };
    private bool IsFreePage => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0] is "projects" or "settings" or "more";

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        Notes.SignInExpired += OnExpired;
        var ok = false;
        await Notes.TryAsync(async () => ok = await State.StartAsync());
        if (!ok) { Nav.NavigateTo("login"); return; }
        _ready = true;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void OnExpired() => InvokeAsync(() => Nav.NavigateTo("login"));

    private async Task OnProject(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id)) await State.OpenProjectAsync(id);
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Notes.SignInExpired -= OnExpired;
    }
}

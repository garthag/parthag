@page "/approvals"
@inherits ProjectPage

<h1>Approvals</h1>
<p class="sub">Reports submitted for review. Open one to check quantities, adjust the accepted quantity if needed, then approve or reject.</p>
@if (!State.Can(Module.Dpr, Act.Approve))
{
    <div class="notice">Your role (@Permissions.Label(State.Role)) does not approve reports. You can still open and read them.</div>
}
@if (Loading) { <div class="loading"><span class="spinner"></span></div> }
else
{
    <div class="list">
        @foreach (var d in _pending)
        {
            <a class="item" href="dprs/@d.Id">
                <div>
                    <div class="t">@d.Number@(d.Revision > 0 ? $" · R{d.Revision}" : "")</div>
                    <div class="s">@d.ReportDate.ToString("ddd dd MMM yyyy", CultureInfo.InvariantCulture) · @d.Shift shift · by @d.PreparedBy · @Fmt.Dt(d.UpdatedAt)</div>
                </div>
                <span class="btn sm primary">Review</span>
            </a>
        }
        @if (_pending.Count == 0) { <div class="card"><p class="muted" style="margin:0">Nothing waiting for approval. ✔</p></div> }
    </div>
}
@code {
    private List<DprSummary> _pending = new();
    protected override async Task LoadAsync() => _pending = (await Api.DprsAsync(Pid)).Where(d => d.Status == DprStatus.Submitted).OrderBy(d => d.ReportDate).ToList();
    protected override bool Wants(LiveChange c) => c.Entity is "dpr" or "all";
}

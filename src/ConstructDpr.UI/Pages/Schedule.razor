@page "/schedule"
@inherits ProjectPage
@inject IFileSaver Files

<div class="head">
    <div><h1>Schedule — Gantt chart</h1><p class="sub" style="margin:0">@_acts.Count activities · @_acts.Count(a => a.Critical) critical · forecast finish @Fmt.D(_acts.Max(a => a.EarlyFinish)) · FS/SS/FF/SF with lag</p></div>
</div>
<div class="row" style="margin-bottom:12px">
    @if (State.Can(Module.Schedule, Act.Edit)) { <button class="btn success" disabled="@_busy" @onclick="Run">▶ Recalculate CPM</button> }
    @if (State.Can(Module.Reports, Act.Export))
    {
        <button class="btn" disabled="@_busy" @onclick="() => Download(ReportKind.SchedulePdf)">PDF (A3)</button>
        <button class="btn" disabled="@_busy" @onclick="() => Download(ReportKind.ScheduleExcel)">Excel</button>
    }
    <label class="row small" style="margin:0 0 0 8px;gap:6px">Zoom <input type="range" min="4" max="36" @bind="_zoom" @bind:event="oninput" style="width:130px;min-height:0" /></label>
</div>
@if (Loading) { <div class="loading"><span class="spinner"></span></div> }
else if (_acts.Count == 0) { <div class="card"><p class="muted" style="margin:0">No activities yet. Add them under Activities &amp; BOQ or import them from Excel.</p></div> }
else { <GanttChart Model="GanttLayout.Build(_acts, _deps, Today, _zoom, 30)" /> }

@code {
    private List<Activity> _acts = new();
    private List<Dependency> _deps = new();
    private double _zoom = 14;
    private bool _busy;

    protected override async Task LoadAsync()
    {
        var t1 = Api.ActivitiesAsync(Pid);
        var t2 = Api.DependenciesAsync(Pid);
        (_acts, _deps) = (await t1, await t2);
    }

    protected override bool Wants(LiveChange c) => c.Entity is "activities" or "dpr" or "all" or "project";

    private async Task Run()
    {
        _busy = true;
        ScheduleSummary? r = null;
        await Notes.TryAsync(async () => { r = await Api.RunScheduleAsync(Pid); await LoadAsync(); });
        if (r is not null) Notes.Show($"Schedule calculated. Forecast finish {Fmt.D(r.ProjectFinish)}, {r.CriticalCount} critical activities.");
        _busy = false;
    }

    private async Task Download(ReportKind kind)
    {
        _busy = true;
        await Notes.TryAsync(async () => { var f = await Api.ReportAsync(Pid, kind); await Files.SaveAsync(f.FileName, f.ContentType, f.Content); });
        _busy = false;
    }
}

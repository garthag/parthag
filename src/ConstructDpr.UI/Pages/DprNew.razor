@page "/dprs/new"
@inherits ProjectPage

<h1>New daily report</h1>
<p class="sub">Crews, equipment and material stock are copied from the previous report, so you only change what is different today.</p>
<div class="card" style="max-width:520px">
    <div class="fields">
        <div class="field"><label for="d">Report date</label><input id="d" type="date" @bind="_date" max="@Today.ToString("yyyy-MM-dd")" /></div>
        <div class="field">
            <label for="s">Shift</label>
            <select id="s" @bind="_shift">@foreach (var s in Enum.GetValues<Shift>()) { <option value="@s">@s</option> }</select>
        </div>
    </div>
    <button class="btn primary" disabled="@_busy" @onclick="Create">Create report</button>
    <a class="btn ghost" href="dprs">Cancel</a>
</div>
@code {
    private DateOnly _date = DateOnly.FromDateTime(DateTime.Today);
    private Shift _shift = Shift.Day;
    private bool _busy;
    protected override Task LoadAsync() => Task.CompletedTask;
    protected override bool Wants(LiveChange c) => false;

    private async Task Create()
    {
        _busy = true;
        Dpr? d = null;
        await Notes.TryAsync(async () => d = await Api.CreateDprAsync(Pid, _date, _shift), "Report created.");
        _busy = false;
        if (d is not null) Nav.NavigateTo($"dprs/{d.Id}");
    }
}

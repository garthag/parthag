<div class="field">
    <label>@Label</label>
    @if (!Edit) { <div style="white-space:pre-line">@(string.IsNullOrWhiteSpace(Value) ? "—" : Value)</div> }
    else if (Multi) { <textarea value="@Value" @onchange="e => Changed.InvokeAsync(e.Value?.ToString())"></textarea> }
    else { <input value="@Value" @onchange="e => Changed.InvokeAsync(e.Value?.ToString())" /> }
</div>
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public bool Edit { get; set; }
    [Parameter] public bool Multi { get; set; }
    [Parameter] public EventCallback<string?> Changed { get; set; }
}

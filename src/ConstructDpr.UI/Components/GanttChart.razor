@* Custom Gantt chart. Geometry comes from GanttLayout (shared with the PDF report and the Windows app).
   Left: activity table (stays in place). Right: scrollable timeline drawn as SVG. *@
@{
    var m = Model;
    var h = Header + m.Rows.Count * m.RowHeight;
}
<div class="gantt">
    <div class="gt">
        <table>
            <thead><tr><th>Code</th><th>Activity</th><th>Start</th><th>Finish</th><th class="num">TF</th></tr></thead>
            <tbody>
                @foreach (var r in m.Rows)
                {
                    <tr class="@(r.Critical ? "crit" : "")" style="height:@(m.RowHeight)px" title="@Tip(r)">
                        <td><b>@r.Code</b></td><td style="max-width:@(NameWidth)px">@r.Name</td><td>@Fmt.Ds(r.Start)</td><td>@Fmt.Ds(r.Finish)</td><td class="num">@r.TotalFloat</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="gs" @ref="_scroll">
        <svg width="@S(m.TotalWidth)" height="@S(h)" viewBox="0 0 @S(m.TotalWidth) @S(h)" role="img" aria-label="Gantt chart">
            <rect x="0" y="0" width="@S(m.TotalWidth)" height="@Header" fill="var(--brand-light)" />
            @for (var i = 1; i < m.Rows.Count; i += 2)
            {
                <rect x="0" y="@S(Header + i * m.RowHeight)" width="@S(m.TotalWidth)" height="@S(m.RowHeight)" fill="var(--muted-bg)" opacity=".45" />
            }
            @foreach (var t in m.Ticks)
            {
                <g>
                    <line x1="@S(t.X)" x2="@S(t.X)" y1="@(t.Major ? 0 : Header / 2)" y2="@S(h)" stroke="@(t.Major ? "var(--base)" : "var(--grid)")" />
                    <text x="@S(t.X + 3)" y="@(t.Major ? 17 : Header - 7)" font-size="@(t.Major ? 12 : 11)" font-weight="@(t.Major ? 650 : 400)" fill="@(t.Major ? "var(--text)" : "var(--muted)")">@t.Label</text>
                </g>
            }
            @foreach (var b in m.Bars)
            {
                var top = Header + b.Row * m.RowHeight;
                <g>
                    <title>@Tip(m.Rows[b.Row])</title>
                    @if (b.BaselineX is { } bx && b.BaselineWidth is { } bw)
                    {
                        <rect x="@S(bx)" y="@S(top + m.RowHeight - 7)" width="@S(bw)" height="4" rx="1.5" fill="var(--base)" />
                    }
                    @if (b.Milestone)
                    {
                        var cy = top + m.RowHeight / 2 - 2;
                        <g><polygon points="@S(b.X),@S(cy - 7) @S(b.X + 7),@S(cy) @S(b.X),@S(cy + 7) @S(b.X - 7),@S(cy)" fill="@(b.Critical ? "var(--crit-dark)" : "var(--brand)")" />
                        <text x="@S(b.X + 11)" y="@S(cy + 4)" font-size="11" fill="var(--muted)">@b.Label</text></g>
                    }
                    else
                    {
                        <rect x="@S(b.X)" y="@S(top + 5)" width="@S(b.Width)" height="@S(m.RowHeight - 14)" rx="3" fill="@(b.Critical ? "var(--crit)" : "var(--brand-mid)")" />
                        @if (b.ProgressFraction > 0)
                        {
                            <rect x="@S(b.X)" y="@S(top + 5)" width="@S(Math.Max(2, b.Width * Math.Min(1, b.ProgressFraction)))" height="@S(m.RowHeight - 14)" rx="3" fill="@(b.Critical ? "var(--crit-dark)" : "var(--brand)")" />
                        }
                        <g><text x="@S(b.X + b.Width + 5)" y="@S(top + m.RowHeight / 2 + 2)" font-size="11" fill="var(--muted)">@b.Label</text></g>
                    }
                </g>
            }
            @foreach (var l in m.Links)
            {
                var y1 = Header + l.Y1 - 2; var y2 = Header + l.Y2 - 2; var color = l.Critical ? "var(--bad)" : "var(--muted)";
                var path = l.X2 - 6 >= l.X1 + 6
                    ? $"M{S(l.X1)},{S(y1)} H{S(l.X1 + 6)} V{S(y2)} H{S(l.X2)}"
                    : $"M{S(l.X1)},{S(y1)} H{S(l.X1 + 6)} V{S(y1 + (y2 > y1 ? m.RowHeight / 2 : -m.RowHeight / 2))} H{S(l.X2 - 6)} V{S(y2)} H{S(l.X2)}";
                <g>
                    <path d="@path" fill="none" stroke="@color" stroke-width="1.1" />
                    <polygon points="@S(l.X2),@S(y2) @S(l.X2 - 5),@S(y2 - 3.5) @S(l.X2 - 5),@S(y2 + 3.5)" fill="@color" />
                </g>
            }
            @if (m.TodayX is { } tx)
            {
                <g><line x1="@S(tx)" x2="@S(tx)" y1="@Header" y2="@S(h)" stroke="var(--accent)" stroke-width="1.6" stroke-dasharray="4 3" />
                <text x="@S(tx + 3)" y="@(Header + 11)" font-size="10" font-weight="650" fill="var(--warn)">Today</text></g>
            }
        </svg>
    </div>
</div>
<div class="legend">
    <span><i style="background:var(--brand-mid)"></i>Activity</span><span><i style="background:var(--crit)"></i>Critical path</span>
    <span><i style="background:var(--brand)"></i>Progress (approved)</span><span><i style="background:var(--base);height:4px"></i>Baseline</span>
    <span>◆ Milestone</span><span style="color:var(--warn)">┆ Today (data date)</span>
</div>
@inject IJSRuntime Js
@code {
    [Parameter, EditorRequired] public GanttModel Model { get; set; } = null!;
    [Parameter] public int NameWidth { get; set; } = 200;
    private const double Header = 46;
    private ElementReference _scroll;
    private bool _scrolled;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrolled || Model.TodayX is not { } x) return;
        _scrolled = true;
        try { await Js.InvokeVoidAsync("cdpr.scrollX", _scroll, x - 220); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    private static string S(double v) => Math.Round(v, 1).ToString(CultureInfo.InvariantCulture);
    private static string Tip(GanttRow r) => $"{r.Code} {r.Name}\nStart {Fmt.D(r.Start)} · Finish {Fmt.D(r.Finish)}\nTotal float {r.TotalFloat?.ToString() ?? "—"} d · progress {Fmt.N(r.ProgressPct, 1)}%" + (r.Critical ? "\nOn the critical path" : "");
}

<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- CONSTRUCT DPR sync server: lets the Android app (and Windows PCs away from the office) reach the SQL database safely. Sign-in, REST API, live updates (SignalR), PDF/Excel. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ConstructDpr.Server</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConstructDpr.Core\ConstructDpr.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ConstructDpr.Tests" />
  </ItemGroup>
</Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ConstructDpr.Server</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConstructDpr.Core\ConstructDpr.Core.csproj" />
    <ProjectReference Include="..\ConstructDpr.Web\ConstructDpr.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ConstructDpr.Tests" />
  </ItemGroup>
</Project>

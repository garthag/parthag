{
  // CONSTRUCT DPR sync server. Phones and remote PCs connect to http://<this-PC>:5080
  "Urls": "http://0.0.0.0:5080",
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",

  // Database. To share data with the Windows app's "Office SQL Server" mode, use the SAME database:
  //   "Provider": "SqlServer"  and  "Default": "Server=.\\SQLEXPRESS;Database=ConstructDpr;Trusted_Connection=True;TrustServerCertificate=True"
  // Left as Sqlite, a file data\construct-dpr.db next to the server is used.
  "Database": { "Provider": "Sqlite" },
  "ConnectionStrings": { "Default": "" },

  "Features": { "AdminPortal": false, "Registration": true },
  "Site": { "TimeZone": "Asia/Kolkata" }
}

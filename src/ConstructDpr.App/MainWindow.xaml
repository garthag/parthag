<Window x:Class="ConstructDpr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CONSTRUCT DPR" Width="1366" Height="840" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}" Icon="Assets/app.ico">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <DockPanel Background="{StaticResource BrandDark}">
      <StackPanel DockPanel.Dock="Top" Margin="22,22,22,18">
        <TextBlock Text="CONSTRUCT" Foreground="White" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="DPR · Desktop" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="22,12,22,18">
        <TextBlock Text="Signed in as" Foreground="#8EA6BA" FontSize="11"/>
        <TextBlock x:Name="UserText" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="ModeText" Foreground="#8EA6BA" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel x:Name="Nav">
        <RadioButton Style="{StaticResource Nav}" Tag="dashboard" Checked="OnNav" IsChecked="True" Content="▦   Dashboard"/>
        <RadioButton Style="{StaticResource Nav}" Tag="activities" Checked="OnNav" Content="☰   Activities &amp; BOQ"/>
        <RadioButton Style="{StaticResource Nav}" Tag="schedule" Checked="OnNav" Content="▤   Schedule (Gantt)"/>
        <RadioButton Style="{StaticResource Nav}" Tag="dpr" Checked="OnNav" Content="✎   Daily reports"/>
        <RadioButton Style="{StaticResource Nav}" Tag="reports" Checked="OnNav" Content="⎙   Reports &amp; Excel"/>
        <RadioButton Style="{StaticResource Nav}" Tag="settings" Checked="OnNav" Content="⚙   Settings"/>
      </StackPanel>
    </DockPanel>

    <!-- Header + page -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="LiveText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="13" Margin="0,0,18,0"/>
            <TextBlock x:Name="DateText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="13"/>
          </StackPanel>
          <StackPanel>
            <ComboBox x:Name="ProjectPicker" FontSize="15" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left"
                      MinWidth="380" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="OnProjectPicked"/>
            <TextBlock x:Name="ProjectSub" FontSize="12" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ContentControl x:Name="Host" Margin="24,18,24,20"/>
    </DockPanel>
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app (WPF). Works offline on this PC (SQLite) or signed in to the server with live sync. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ConstructDpr</AssemblyName>
    <RootNamespace>ConstructDpr.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConstructDpr.Core\ConstructDpr.Core.csproj" />
    <ProjectReference Include="..\ConstructDpr.Client\ConstructDpr.Client.csproj" />
    <!-- "Let phones connect to this PC": the sync server runs inside the Windows app. -->
    <ProjectReference Include="..\ConstructDpr.Server\ConstructDpr.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
</Project>

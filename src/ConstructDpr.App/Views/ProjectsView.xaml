<UserControl x:Class="ConstructDpr.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="Projects &amp; people" Style="{StaticResource H1}"/>
      <TextBlock x:Name="Summary" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorder}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Your projects" Style="{StaticResource H2}"/>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="Open" Style="{StaticResource Primary}" Click="OnOpen" Margin="0,0,8,6"/>
            <Button x:Name="NewBtn" Content="＋ New project…" Click="OnNew" Margin="0,0,8,6"/>
            <Button Content="Load demo project" Click="OnDemo" Margin="0,0,8,6"/>
          </WrapPanel>
          <DataGrid x:Name="ProjectGrid" IsReadOnly="True" MouseDoubleClick="OnOpen" SelectionChanged="OnProjectSelected">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110"/>
              <DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="140"/>
              <DataGridTextColumn Header="Your role" Binding="{Binding RoleLabel}" Width="150"/>
              <DataGridTextColumn Header="" Binding="{Binding Open}" Width="60"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardBorder}">
        <DockPanel>
          <TextBlock x:Name="PeopleTitle" DockPanel.Dock="Top" Text="People" Style="{StaticResource H2}"/>
          <TextBlock x:Name="PeopleNote" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <StackPanel x:Name="AddPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="E-mail of a person who already has an account" Style="{StaticResource Label}"/>
            <DockPanel Margin="0,0,0,8">
              <ComboBox x:Name="RolePick" DockPanel.Dock="Right" Width="200" Margin="8,0,0,0" DisplayMemberPath="Label" SelectedValuePath="Role"/>
              <TextBox x:Name="EmailBox"/>
            </DockPanel>
            <WrapPanel>
              <Button Content="Add / change role" Style="{StaticResource Primary}" Click="OnAddMember" Margin="0,0,8,0"/>
              <Button Content="Remove selected" Style="{StaticResource Danger}" Click="OnRemoveMember"/>
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="People" IsReadOnly="True" SelectionChanged="OnPersonSelected">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
              <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*"/>
              <DataGridTextColumn Header="Role" Binding="{Binding RoleLabel}" Width="170"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>

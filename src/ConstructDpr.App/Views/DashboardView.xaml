<UserControl x:Class="ConstructDpr.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ConstructDpr.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Dashboard" Style="{StaticResource H1}" Margin="0,0,0,14"/>
      <UniformGrid x:Name="Kpis" Columns="4" Margin="-6,0,-6,8"/>
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="S-curve — weighted physical progress" Style="{StaticResource H2}"/>
            <c:SCurveChart x:Name="Curve" Height="300"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="Activities needing attention" Style="{StaticResource H2}"/>
            <ItemsControl x:Name="Attention">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,7">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" Foreground="{Binding BadgeBrush}" FontWeight="SemiBold" FontSize="12"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
      <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Progress by activity (accepted quantities)" Style="{StaticResource H2}"/>
          <ItemsControl x:Name="Bars">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <Grid Grid.Column="1" Height="14" Margin="8,0">
                    <Border Background="#E8EDF2" CornerRadius="3"/>
                    <ProgressBar Value="{Binding Pct, Mode=OneWay}" Maximum="100" Background="Transparent" BorderThickness="0" Foreground="{Binding BadgeBrush}"/>
                  </Grid>
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

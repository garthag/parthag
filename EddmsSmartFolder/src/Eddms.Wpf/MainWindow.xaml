<Window x:Class="Eddms.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Eddms.Wpf"
        Title="EDMS Drawing Register" Width="1400" Height="820" WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" Padding="10,8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="EDMS Drawing Register" Foreground="White" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,20,0"/>
                <Button x:Name="SyncButton" Content="⟳  Sync from EDMS" Click="Sync_Click" FontWeight="SemiBold"/>
                <Button x:Name="CancelButton" Content="Stop" Click="Cancel_Click" IsEnabled="False"/>
                <CheckBox x:Name="DownloadCheck" Content="Download drawings" Foreground="White"
                          VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock Text="Search:" Foreground="White" VerticalAlignment="Center" Margin="20,0,6,0"/>
                <TextBox x:Name="SearchBox" Width="260" VerticalContentAlignment="Center" Padding="4,2"
                         TextChanged="Search_TextChanged" ToolTip="Document number, description, file name, approval code..."/>
                <Button DockPanel.Dock="Right" Content="Open drawings folder" Click="OpenRoot_Click"/>
                <Button DockPanel.Dock="Right" Content="Export to Excel (CSV)" Click="Export_Click"/>
                <Button DockPanel.Dock="Right" Content="Open drawing" Click="OpenFile_Click"/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Padding="6,2">
            <StatusBarItem>
                <ProgressBar x:Name="Progress" Width="220" Height="14" Minimum="0" Maximum="1"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CountText"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="Tabs" Margin="6" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="  Smart Folders  " x:Name="FoldersTab">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" MinWidth="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <CheckBox x:Name="SubFoldersCheck" DockPanel.Dock="Bottom" Margin="4,6"
                                  Content="Include documents of sub-folders" IsChecked="True"
                                  Checked="SubFolders_Changed" Unchecked="SubFolders_Changed"/>
                        <TreeView x:Name="FolderTree" SelectedItemChanged="FolderTree_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="Padding" Value="2,3"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding CountLabel}" Foreground="#1A797B" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E0E8E8"/>
                    <DockPanel Grid.Column="2">
                        <TextBlock x:Name="FolderPathText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="4,2,4,6"/>
                        <DataGrid x:Name="DocumentsGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                                  MouseDoubleClick="Grid_MouseDoubleClick"/>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="  Submission Register  " x:Name="SubmissionTab">
                <DataGrid x:Name="SubmissionGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                          MouseDoubleClick="Grid_MouseDoubleClick" LoadingRow="Submission_LoadingRow"/>
            </TabItem>
            <TabItem Header="  Revision Register  " x:Name="RevisionTab">
                <DataGrid x:Name="RevisionGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                          MouseDoubleClick="Grid_MouseDoubleClick" LoadingRow="Revision_LoadingRow"/>
            </TabItem>
            <TabItem Header="  Published Drawings  " x:Name="PublishedTab">
                <DataGrid x:Name="PublishedGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                          MouseDoubleClick="Grid_MouseDoubleClick"/>
            </TabItem>
            <TabItem Header="  Sync History  " x:Name="HistoryTab">
                <DataGrid x:Name="HistoryGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn" FrozenColumnCount="0"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

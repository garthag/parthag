# Copy to web/.env and fill in. These values are PUBLIC (they ship in the
# browser bundle). Never put the service-role key or Google secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Set to false to run without Google Drive (files stay queued on devices).
VITE_DRIVE_ENABLED=true

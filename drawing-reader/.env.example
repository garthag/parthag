# Copy to .env and fill in before running docker-compose.prod.yml
POSTGRES_USER=drawing
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=drawing_reader
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
CORS_ORIGINS=https://drawings.example.com
HTTP_PORT=80
# Load the sample projects on first start (false for real deployments)
SEED_ON_START=false
WEB_CONCURRENCY=4
CELERY_CONCURRENCY=2
OCR_ENGINE=auto
MAX_UPLOAD_MB=200
# Optional: enables the LLM fallback for questions the AI assistant's rule parser does not recognise
ANTHROPIC_API_KEY=
# Image coordinates used by CI/CD deploys
REGISTRY=ghcr.io/your-org/drawing-reader
IMAGE_TAG=latest

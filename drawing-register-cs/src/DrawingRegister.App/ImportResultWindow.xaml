<Window x:Class="DrawingRegister.App.ImportResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload finished" Width="760" Height="460" MinWidth="520" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="16">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0" />
        </StackPanel>
        <DataGrid x:Name="ItemsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="95" />
                <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="2*" />
                <DataGridTextColumn Header="Drawing" Binding="{Binding DrawingNumber}" Width="*" />
                <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="45" />
                <DataGridTextColumn Header="Discipline" Binding="{Binding Discipline}" Width="90" />
                <DataGridTextColumn Header="Note" Binding="{Binding Error}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

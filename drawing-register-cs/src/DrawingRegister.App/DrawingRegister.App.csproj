<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>DrawingRegister</AssemblyName>
    <RootNamespace>DrawingRegister.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Drawing Register</Product>
    <Company>Drawing Register</Company>
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrawingRegister.Core\DrawingRegister.Core.csproj" />
  </ItemGroup>

</Project>

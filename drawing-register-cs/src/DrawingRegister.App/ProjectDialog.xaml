<Window x:Class="DrawingRegister.App.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20,14,20,18">
        <TextBlock x:Name="Heading" Text="Add project" FontSize="16" FontWeight="SemiBold" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Project code *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CodeBox" MaxLength="40" CharacterCasing="Upper" AutomationProperties.Name="Project code" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Project name *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" MaxLength="255" AutomationProperties.Name="Project name" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Client" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="ClientBox" MaxLength="255" />

        <TextBlock Text="Location" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="LocationBox" MaxLength="255" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="StatusBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Start date" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="StartBox" SelectedDateFormat="Short" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="End date" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="EndBox" SelectedDateFormat="Short" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DescriptionBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

        <TextBlock x:Name="ErrorText" Foreground="#C62828" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource ToolButton}" MinWidth="80" />
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="90"
                    Margin="0" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>

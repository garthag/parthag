<Window x:Class="DrawingRegister.App.DrawingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit drawing" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20,14,20,18">
        <TextBlock Text="Edit drawing" FontSize="16" FontWeight="SemiBold" />

        <TextBlock Text="Drawing number *" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NumberBox" MaxLength="120" CharacterCasing="Upper" />

        <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="TitleBox" MaxLength="500" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Discipline" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="DisciplineBox" IsEditable="True" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="StatusBox" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Area" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="AreaBox" MaxLength="40" CharacterCasing="Upper" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Drawing type (GA, ISO, P&amp;ID…)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="TypeBox" MaxLength="60" CharacterCasing="Upper" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Remarks" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="RemarksBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

        <TextBlock x:Name="ErrorText" Foreground="#C62828" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource ToolButton}" MinWidth="80" />
            <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
